# Copy outside this directory, replace values, and create the Secret as documented.
STIVA_ACCESS_KEY=REPLACE_WITH_CUSTOM_ACCESS_KEY
# Generate each independently with: openssl rand -hex 32
STIVA_SECRET_KEY=
STIVA_JWT_SECRET=
STIVA_METRICS_TOKEN=
# Optional: replication and webhook credentials belong in this Secret too.
# STIVA_SYNC_ACCESS_KEY=
# STIVA_SYNC_SECRET_KEY=
# STIVA_WEBHOOK_SECRET=
