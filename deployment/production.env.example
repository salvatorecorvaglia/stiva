# Copy to deployment/production.env (ignored). Use real, reviewed digests.
STIVA_IMAGE=corvaglia91/stiva@sha256:REPLACE_WITH_RELEASE_DIGEST
CADDY_IMAGE=caddy:2.11.7-alpine@sha256:24ec7b05bc532c7bb57f727030c5056e257ff7138b4b50460306819ff79362bd
STIVA_S3_HOST=s3.example.com
STIVA_DATA_PATH=/srv/stiva/data
STIVA_ACCESS_KEY=REPLACE_WITH_CUSTOM_ACCESS_KEY
# Generate each independently: openssl rand -hex 32
STIVA_SECRET_KEY=
STIVA_JWT_SECRET=
STIVA_METRICS_TOKEN=
STIVA_REGION=us-east-1
STIVA_MEMORY_LIMIT=2G
# Optional replication destination: use a dedicated empty bucket with versioning.
STIVA_SYNC_ENDPOINT=
STIVA_SYNC_BUCKET=
STIVA_SYNC_ACCESS_KEY=
STIVA_SYNC_SECRET_KEY=
STIVA_SYNC_REGION=us-east-1
STIVA_WEBHOOK_URL=
STIVA_WEBHOOK_SECRET=
