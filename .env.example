# ──────────────────────────────────────────────────────────────────────
# Stiva Environment Configuration Template
# ──────────────────────────────────────────────────────────────────────
# Copy this file to '.env' and modify the values for your environment.
#
#   cp .env.example .env
#
# ⚠️ WARNING: Change the default credentials before running in production!

# ──────────────────────────────────────────────────────────────────────
# Core Server Configuration
# ──────────────────────────────────────────────────────────────────────

# S3 access key used for authentication
STIVA_ACCESS_KEY=stiva

# S3 secret key used for authentication
STIVA_SECRET_KEY=stiva123

# Root directory for storing buckets and objects
STIVA_DATA_DIR=./data

# Port the S3 API server listens on
STIVA_S3_PORT=9000

# Port the web console listens on
STIVA_CONSOLE_PORT=9001

# S3 region reported by the server
STIVA_REGION=us-east-1

# Base domain used for virtual host S3 bucket routing (e.g., bucket.domain.com)
# STIVA_DOMAIN=

# Custom public S3 endpoint URL (e.g., https://s3.example.com) used when
# generating presigned object URLs in the Console. Overrides request-host resolution.
# STIVA_S3_ENDPOINT=

# ──────────────────────────────────────────────────────────────────────
# SSL / TLS Configuration
# ──────────────────────────────────────────────────────────────────────

# Enable to serve S3 API and Console over HTTPS/TLS (requires Cert and Key files)
# STIVA_TLS_ENABLED=false
# STIVA_TLS_CERT=
# STIVA_TLS_KEY=

# ──────────────────────────────────────────────────────────────────────
# Console Security & Rate Limiting
# ──────────────────────────────────────────────────────────────────────

# JWT secret key used for console session authentication.
# Persistent signing key preserves user sessions across server restarts.
# If left blank, a random secret is generated on startup.
# Must be at least 32 characters: a short HS256 secret can be brute-forced
# offline from a single captured session token.
# STIVA_JWT_SECRET=yoursecretkeyhere

# Trust client's X-Forwarded-For header for rate limiting (when running behind a proxy like Nginx/Caddy/Cloudflare)
# STIVA_TRUST_PROXY=false

# Number of reverse proxies in front of Stiva. The client IP is read this many
# entries from the RIGHT of X-Forwarded-For; entries further left are supplied
# by the caller and cannot be trusted. Only meaningful with STIVA_TRUST_PROXY.
# STIVA_TRUSTED_PROXY_HOPS=1

# Maximum console login requests allowed per minute per IP
# Requests per minute per IP for the login endpoint.
# Must be positive. Use -1 to disable rate limiting entirely; 0 is rejected at
# startup because it would allow no requests at all and lock you out.
# STIVA_LOGIN_RATE_LIMIT=5

# Maximum console API requests allowed per minute per IP
# Requests per minute per IP for other console endpoints. Use -1 to disable.
# STIVA_API_RATE_LIMIT=60

# ──────────────────────────────────────────────────────────────────────
# Prometheus Metrics Configuration
# ──────────────────────────────────────────────────────────────────────

# Authentication token required to access the /metrics endpoint.
# Scrapers must supply this token in the header: Authorization: Bearer <token>
# If left blank, accesses to /metrics fall back to Console JWT verification.
# STIVA_METRICS_TOKEN=yourmetricstokenhere

# ──────────────────────────────────────────────────────────────────────
# Storage Limits
# ──────────────────────────────────────────────────────────────────────

# Maximum size in bytes accepted for a single object or multipart part,
# enforced by the storage engine itself regardless of signing mode (a client
# sending UNSIGNED-PAYLOAD bypasses the SigV4 layer's own size check
# entirely). 0 disables the cap.
# STIVA_MAX_OBJECT_SIZE=5368709120

# ──────────────────────────────────────────────────────────────────────
# Logging & Debugging
# ──────────────────────────────────────────────────────────────────────

# Output log verbosity (debug, info, warn, error)
# STIVA_LOG_LEVEL=info

# Logger format (text or json)
# STIVA_LOG_FORMAT=text

# Disable the S3 5MB minimum multipart size limitation (useful for testing)
# STIVA_DISABLE_MIN_PART_SIZE=false

# ──────────────────────────────────────────────────────────────────────
# Active-Passive Mirroring (Asynchronous replication)
# ──────────────────────────────────────────────────────────────────────

# Endpoint URL of the replication destination (e.g., https://s3.eu-west-1.amazonaws.com)
# STIVA_SYNC_ENDPOINT=

# Target bucket name at the replication destination
# STIVA_SYNC_BUCKET=

# Access Key of the replication target credentials
# STIVA_SYNC_ACCESS_KEY=

# Secret Key of the replication target credentials
# STIVA_SYNC_SECRET_KEY=

# Region of the replication target credentials
# STIVA_SYNC_REGION=us-east-1

# ──────────────────────────────────────────────────────────────────────
# Webhook Event Notifications
# ──────────────────────────────────────────────────────────────────────

# Destination POST endpoint to receive webhook notifications (e.g., http://my-service/events)
# STIVA_WEBHOOK_URL=

# Shared secret used to sign webhook payloads. When set, each request carries
# an X-Stiva-Signature: sha256=<hmac> header computed over the JSON body, so
# receivers can verify the event genuinely came from this server.
# STIVA_WEBHOOK_SECRET=
